# Excepción documentada: connect-src incluye https://twinverdict.focampo.com
# para el deck del detalle técnico (telemetría y enlaces reescritos por gantt.js).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://twinverdict.focampo.com; frame-ancestors 'none'; base-uri 'self'
