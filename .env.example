# Local Postgres. Same major version as CI and Railway (16). This password is the local dev role only.
DATABASE_URL=postgresql+psycopg://planta:planta@localhost:5432/planta
# replay serves the recorded run. live calls vLLM and the simulator.
MODE=replay
# Recorded run served by the demo. Earlier jobs stay in the repo as history.
REPLAY_JOB_ID=c0c92625-de22-4520-accb-6a17c1a76428
LLM_BASE_URL=http://localhost:8001/v1
# Default model. Qwen3-32B was measured for policy quality; 8B remains the default.
LLM_MODEL=Qwen/Qwen3-8B
# The mock server accepts this value. On a real GPU, set the vLLM key for that session in the shell. Never commit it.
LLM_API_KEY=mock
# Sampling the client sends to vLLM. top_k=-1 leaves sampling open.
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_TOP_K=-1
# Optional. Leave empty for the public replay demo.
ADMIN_TOKEN=
SIM_WORKERS=2
