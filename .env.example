DATABASE_URL=postgresql+psycopg://planta:planta@localhost:5432/planta
MODE=replay
# Corrida que sirve la demo en replay. c43bd2f0 queda como histórico.
REPLAY_JOB_ID=c0c92625-de22-4520-accb-6a17c1a76428
LLM_BASE_URL=http://localhost:8001/v1
# Qwen3-8B es el modelo elegido. Qwen3-32B se evaluará por calidad de política.
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=mock
# Muestreo que el cliente manda a vLLM. top_k=-1 deja el muestreo abierto.
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_TOP_K=-1
ADMIN_TOKEN=
SIM_WORKERS=2
