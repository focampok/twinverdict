# Copiar a infra/gpu/.env.gpu en la instancia. Nunca al repo.
# fijar el tag exacto que funcione hoy
VLLM_IMAGE=rocm/vllm:latest
MODEL=
VLLM_API_KEY=
MAX_MODEL_LEN=8192
GPU_MEM_UTIL=0.90
VLLM_PORT=8000
VLLM_WAIT_TIMEOUT=300
HF_TOKEN=
HF_HOME=/var/lib/hf-cache
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=
LLM_API_KEY=
REPO_URL=https://github.com/focampok/twinverdict.git
